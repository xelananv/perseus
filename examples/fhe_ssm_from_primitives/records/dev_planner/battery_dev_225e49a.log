            if not (Path(src) / inside).exists():
                pytest.skip(f"no {var} at {src}")
            env[var] = src
            cmds = [["bash", tool, graph, out_name, route]]
        else:
            cmds = [["bash", tool, graph, out_name], ["bash", tool, graph, out_name, "argmax"]]
